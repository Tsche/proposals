\cowel_html_element("h2"){Annex C (informative) \stable_ref{diff}}
\cowel_html_element("h3"){C++ and ISO C++ 2026 \stable_ref{diff.cpp26}}
\cowel_html_element("h3"){\eelis{lex} lexical conventions \stable_ref{diff.cpp26.lex}}
Add new entry
\Bins{
\ins{
\p{\b{Affected subclauses:} \eelis{lex.pptoken}, \eelis{lex.operators} and \eelis{lex.alt}}
\p{\b{Change:} The "digraph" tokens \tcode{<%}, \tcode{%>}, \tcode{<:}, \tcode{:>}, \tcode{%:} and \tcode{%:%:} are no longer usable as alternative representations of other tokens.}
\p{\b{Rationale:} Resolves fragmentation of the language, opens up design space and simplifies the language.}
\p{\b{Effect on original feature:} 
  Valid C++ 2026 code that uses the digraphs \tcode{<%}, \tcode{%>}, \tcode{<:}, \tcode{:>}, \tcode{%:} and \tcode{%:%:} may become ill-formed or have different meaning in this version of C++. The character sequences \tcode{<%}, \tcode{%>}, \tcode{<:}, \tcode{:>}, \tcode{%:} and \tcode{%:%:} are no longer recognized as single preprocessing tokens. Occurrences within comments and literals are unaffected.
The meaning of these token sequences may change in future versions of C++.}
}
}

